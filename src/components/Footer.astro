---
// Footer.astro
const { pathname } = Astro.url;

const normalize = (p: string) => p.replace(/\/+$/, "") || "/";
const current = normalize(pathname);

const isActive = (href: string) => {
  const h = normalize(href);
  if (h === "/") return current === "/";
  return current === h || current.startsWith(h + "/");
};

const linkClass = (href: string) =>
  `text-md font-medium px-6 py-2 rounded-full border transition-all duration-200 ${
    isActive(href)
      ? "border-neutral-400 text-neutral-900 bg-neutral-100"
      : "border-neutral-500 text-neutral-500 hover:text-neutral-600 hover:border-neutral-500 hover:bg-neutral-50"
  }`;
---

<footer class="bg-white">
  <div class="max-w-6xl mx-auto flex flex-wrap justify-center gap-4">
    <a href="/about" class={linkClass("/about")}>About</a>
  </div>
</footer>
