---
interface Props {
  blurb: string;
  websiteHref?: string;
  websiteLabel?: string; // defaults to "visit website"
  services: string[];
  industries: string[];
  challenge: string;
  whatWeDid: string[];
}

const {
  blurb,
  websiteHref,
  websiteLabel = "visit website",
  services = [],
  industries = [],
  challenge,
  whatWeDid = [],
} = Astro.props as Props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-start">
  <!-- Left: blurb + CTA -->
  <div>
    <p
      class="text-[26px] sm:text-[28px] lg:text-[32px] leading-[1.35] tracking-[-0.012em] font-semibold pr-24"
    >
      {blurb}
    </p>

    {
      websiteHref && (
        <a
          href={websiteHref}
          class="mt-8 inline-flex items-center gap-2 text-[22px] sm:text-[24px] font-semibold text-indigo-500 hover:opacity-85 transition"
        >
          {websiteLabel} <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>

  <!-- Right: fixed sections -->
  <div class="w-full">
    <!-- Services -->
    <div class="grid grid-cols-5 gap-6 pb-6">
      <h3 class="col-span-2 text-[18px] leading-6 font-semibold">Services</h3>
      <div class="col-span-3">
        <ul class="text-[18px] leading-7 font-medium">
          {services.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
    <div class="border-t border-neutral-200"></div>

    <!-- Industries -->
    <div class="grid grid-cols-5 gap-6 py-6">
      <h3 class="col-span-2 text-[18px] leading-6 font-semibold">Industries</h3>
      <div class="col-span-3">
        <ul class="text-[18px] leading-7 font-medium">
          {industries.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
    <div class="border-t border-neutral-200"></div>

    <!-- Challenge -->
    <div class="grid grid-cols-5 gap-6 py-6">
      <h3 class="col-span-2 text-[18px] leading-6 font-semibold">Challenge</h3>
      <p class="col-span-3 text-[18px] leading-7 font-medium">
        {challenge}
      </p>
    </div>
    <div class="border-t border-neutral-200"></div>

    <!-- What we did -->
    <div class="grid grid-cols-5 gap-6 pt-6">
      <h3 class="col-span-2 text-[18px] leading-6 font-semibold">
        What we did
      </h3>
      <div class="col-span-3">
        <ul class="list-disc pl-5 text-[18px] leading-7 space-y-1 font-medium">
          {whatWeDid.map((w) => <li>{w}</li>)}
        </ul>
      </div>
    </div>
  </div>
</div>
