---

<WorkNavigation
  client:load
  scrollContainerId={scrollContainerId}
  updateHash={updateHash}
/>
<div class="max-w-[1800px] mx-auto relative">
  {
    showMobileHeader && (
      <header class="lg:hidden fixed top-12 left-1/2 -translate-x-1/2 z-50">
        <div class="flex items-center justify-center gap-6 px-8" role="banner">
          <a href="/" aria-label="Houd Lab" class="flex items-center gap-3 group">
            <img
              src="/hyhy.png"
              alt="Houd Lab Logo"
              class="h-12 w-auto transition-transform duration-300 group-hover:scale-105"
            />
          </a>
        </div>
      </header>
    )
  }
  <!-- <SmoothScroll client:load /> -->

  <section id="afus" data-work="afus">
    <ProjectShowcase
      titleAr="أفوس"
      subtitle="Designing the identity and digital experience for Afus."
      rows={afus}
      anchorId="afus"
    />
  </section>

  <section id="zemium" data-work="zemium" class="scroll-mt-[320px] mt-12">
    <ProjectShowcase
      titleAr="زيــميوم"
      subtitle="Designing the identity and website for a leading SAP recruitment firm."
      rows={zemium}
      anchorId="zemium"
    />
  </section>

  <section id="allied" class="scroll-mt-[320px] mt-12">
    <ProjectShowcase
      titleAr="ألايــد"
      subtitle="We redesigned a clean, minimal digital presence for Allied."
      rows={allied}
      anchorId="allied"
    />
  </section>

  <section id="casablanca" class="scroll-mt-[320px] mt-12">
    <ProjectShowcase
      titleAr="فندق كازابلانكا"
      subtitle="Virtual reality dashboard experience for Casablanca Hotel."
      rows={casablanca}
      anchorId="casablanca"
    />
  </section>

  <section id="vf" class="scroll-mt-[320px] mt-12">
    <ProjectShowcase
      titleAr="فيزيت فوتبول"
      subtitle="We redesigned the complete booking experience for football fans worldwide."
      rows={vf}
      anchorId="vf"
    />
  </section>

  <section id="selenitis" class="scroll-mt-[320px] mt-12">
    <ProjectShowcase
      titleAr="ســيلينيتيس"
      subtitle="Crafting a timeless identity for a luxury brand."
      rows={selenitis}
      anchorId="selenitis"
    />
  </section>

  <section id="folklore" class="scroll-mt-[320px] mt-12">
    <ProjectShowcase
      titleAr="فــولكلور ٢٤"
      subtitle="Creating the brand and landing page for a cultural moroccan storytelling project."
      rows={folklore}
      anchorId="folklore"
    />
  </section>

  <section id="pve" class="scroll-mt-[320px] mt-12">
    <ProjectShowcase
      titleAr="بي في إنيرجي"
      subtitle="Branding and designing the landing experience for a solar energy startup."
      rows={pve}
      anchorId="pve"
    />
  </section>

  <section id="knockout" class="scroll-mt-[320px] mt-12">
    <ProjectShowcase
      titleAr="نـوك آوت"
      subtitle="Creating bold social visuals and ad campaigns for Knockout."
      rows={knockout}
      anchorId="knockout"
    />
  </section>

  <section id="masterpiece" class="scroll-mt-[320px] mt-12">
    <ProjectShowcase
      titleAr="ماستر بيـس"
      subtitle="Minimal digital portfolio for a product design studio."
      rows={masterpiece}
      anchorId="masterpiece"
    />
  </section>

  {showFooter && (
    <footer class="h-20 flex items-center justify-center relative">
      <footer
        class="bg-white items-end pb-1 bottom-5 border border-black text-black hover:text-neutral-600 hover:border-neutral-500 hover:bg-neutral-50 fixed rounded-full transition-colors duration-200"
      >
        <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-center gap-4">
          <a
            href="/"
            class="text-lg 2xl:text-xl font-medium px-6 py-1 2xl:py-1 2xl:px-6 rounded-full transition-all duration-200"
          >
            Back
          </a>
        </div>
      </footer>
    </footer>
  )}
</div>

