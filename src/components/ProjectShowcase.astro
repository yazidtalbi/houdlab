---
import { Image } from "astro:assets";

type Img = { src: any; alt?: string; class?: string };
type Row =
  | { variant: "regular"; image: Img }
  | { variant: "two"; left: Img; right: Img };

const {
  titleAr,
  subtitle,
  rows = [],
  className = "",
  imgQuality = 95,
  imgFormat = "jpeg",
  // NEW: provide a stable anchor id for this section (e.g., "zemium")
  anchorId,
} = Astro.props as {
  titleAr?: string;
  subtitle?: string;
  rows: Row[];
  className?: string;
  imgQuality?: 100;
  imgFormat?: "jpeg" | "webp" | "avif";
  anchorId?: string;
};

const baseImg =
  "rounded-2xl w-full h-auto object-cover [content-visibility:auto] [contain-intrinsic-size:1000px_600px]";
const borderedImg =
  "rounded-2xl border border-gray-200 w-full h-auto object-cover [content-visibility:auto] [contain-intrinsic-size:1000px_600px]";

const isImportedAsset = (src: any) =>
  typeof src === "object" && src && "src" in src && "width" in src && "height" in src;

const widthsSingle = [640, 768, 1024, 1536, 1920, 2560];
const widthsHalf = [480, 640, 768, 960, 1024, 1536, 1920, 2560];

const sizesSingle =
  "(min-width:1536px) 1440px, (min-width:1280px) 1440px, (min-width:768px) 80vw, 100vw";
const sizesHalf =
  "(min-width:1536px) 720px, (min-width:1280px) 720px, (min-width:768px) 40vw, 100vw";
---

<!-- Make the whole section a hover group; set id for the hash target -->
<section id={anchorId} class={`max-w-6xl mx-auto group ${className}`}>
  {
    (titleAr || subtitle) && (
      <section class="pt-60 pb-20 text-center relative">
        {titleAr && (
          <div class="inline-block relative">
          
            {anchorId && (
              <button
                type="button"
                class="js-copy-anchor absolute -left-10 top-1/2 -translate-y-1/2 -mt-6
                       opacity-0 group-hover:opacity-100 transition-opacity duration-300
                       text-gray-400 hover:text-gray-600 cursor-pointer"
                aria-label="Copy section link"
                title="Copy link"
                data-anchor={anchorId}
              >
                <!-- simple 'link' icon (no external deps) -->
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 1 0-7.07-7.07L11 4"/>
                  <path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 1 0 7.07 7.07L13 20"/>
                </svg>
              </button>
            )}

            <h2
              dir="rtl"
              lang="ar"
              class="font-[Amiri] text-3xl md:text-4xl font-medium leading-snug text-neutral-900 pb-14"
            >
              {titleAr}
            </h2>
          </div>
        )}

        {subtitle && (
          <h2 class="text-2xl md:text-2xl font-normal max-w-xs mx-auto text-neutral-900 leading-snug">
            {subtitle}
          </h2>
        )}
      </section>
    )
  }

  <div class="flex flex-col gap-y-6">
    {
      rows.map((row, i) => {
        const eager = i === 0;

        if (row.variant === "two") {
          return (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6" key={i}>
              <div>
                {isImportedAsset(row.left.src) ? (
                  <Image
                    src={row.left.src}
                    alt={row.left.alt ?? ""}
                    widths={widthsHalf}
                    sizes={sizesHalf}
                    quality={imgQuality}
                    format={imgFormat}
                    loading={eager ? "eager" : "lazy"}
                    fetchpriority={eager ? "high" : undefined}
                    class={`${baseImg} ${row.left.class ?? ""}`}
                  />
                ) : (
                  <img
                    src={row.left.src}
                    alt={row.left.alt ?? ""}
                    loading="lazy"
                    class={`${baseImg} ${row.left.class ?? ""}`}
                  />
                )}
              </div>

              <div>
                {isImportedAsset(row.right.src) ? (
                  <Image
                    src={row.right.src}
                    alt={row.right.alt ?? ""}
                    widths={widthsHalf}
                    sizes={sizesHalf}
                    quality={imgQuality}
                    format={imgFormat}
                    loading="lazy"
                    class={`${baseImg} ${row.right.class ?? ""}`}
                  />
                ) : (
                  <img
                    src={row.right.src}
                    alt={row.right.alt ?? ""}
                    loading="lazy"
                    class={`${baseImg} ${row.right.class ?? ""}`}
                  />
                )}
              </div>
            </div>
          );
        }

        return (
          <div key={i}>
            {isImportedAsset(row.image.src) ? (
              <Image
                src={row.image.src}
                alt={row.image.alt ?? ""}
                widths={widthsSingle}
                sizes={sizesSingle}
                quality={imgQuality}
                format={imgFormat}
                loading={eager ? "eager" : "lazy"}
                fetchpriority={eager ? "high" : undefined}
                class={`${borderedImg} ${row.image.class ?? ""}`}
              />
            ) : (
              <img
                src={row.image.src}
                alt={row.image.alt ?? ""}
                loading="lazy"
                class={`${borderedImg} ${row.image.class ?? ""}`}
              />
            )}
          </div>
        );
      })
    }
  </div>

  <!-- tiny, scoped handler -->
  <script is:raw>
    (function () {
      document.addEventListener('click', function (e) {
        const btn = e.target.closest('.js-copy-anchor');
        if (!btn) return;

        e.preventDefault();
        const id = btn.getAttribute('data-anchor');
        const url = location.origin + location.pathname + (id ? '#' + id : '');
        navigator.clipboard.writeText(url).then(function () {
          // flash success color
          btn.classList.add('text-green-600');
          setTimeout(function(){ btn.classList.remove('text-green-600'); }, 900);
        }).catch(function(){ /* fail silently */ });
      }, { passive: true });
    })();
  </script>
</section>
