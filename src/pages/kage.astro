---
import "../styles/global.css";

import ChatPanel from "../components/ChatPanel";
import KageCarousel from "@/components/KageCarousel";
import Footer from "../components/Footer.astro";
import TestimonialsCard from "@/components/TestimonialsCard";

import TestimonialsCarouselAm, {
  Testimonial,
} from "@/components/TestimonialsCarouselAm";

const testimonials: Testimonial[] = [
  {
    rating: 5,
    scoreLabel: "5.0",
    quote: [
      "This service completely changed how we work. azdaz da dazdzad zadzad adza dadaz ",
    ],
    author: {
      name: "Jane Doe",
      title: "CEO",
      company: "Startup Inc.",
      avatarUrl: "https://i.pravatar.cc/80?img=65",
    },
  },
  {
    rating: 5,
    scoreLabel: "5.0",
    quote: "The fastest way we’ve shipped in months. azdaz dad adad ",
    author: {
      name: "Sam Park",
      title: "Head of Product",
      company: "Acme Corp",
      avatarUrl: "https://i.pravatar.cc/80?img=32",
    },
    durationMs: 6000, // custom per-slide timing (optional)
  },
];

const demo = [
  {
    id: 1,
    type: "image",
    src: "https://images.pexels.com/photos/34100151/pexels-photo-34100151.jpeg",
    caption: "Zemium — Cloud hosting rebrand + case study cards",
    durationMs: 4500,
    ctaLabel: "View case study",
    ctaHref: "/projects/relocate-now",
  },
  {
    id: 2,
    type: "image",
    src: "https://images.pexels.com/photos/34203371/pexels-photo-34203371.jpeg",
    caption: "Allied — map UI tiles",
    ctaLabel: "View case study",
    ctaHref: "/projects/zemium",
  },
];

import testimonials from "@/data/testimonials";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Houd Lab — Establishing Brands & Products</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="flex flex-col min-h-screen">
    <header class="fixed top-10 left-0 w-full z-50">
      <div class="flex items-center gap-6 pl-8 pr-8" role="banner">
        <!-- Logo link -->
        <a href="/" aria-label="Houd Lab" class="flex items-center gap-3 group">
          <img
            src="/hyhy.png"
            alt="Houd Lab Logo"
            class="h-12 w-auto transition-transform duration-300 group-hover:scale-105"
          />
        </a>

        <!-- Divider + text -->
        <div class="border-l border-gray-200 pl-5 -ml-1 pb-1">
          <p
            class="text-neutral-800 font-display font-semibold text-xl leading-tight md:leading-snug lg:text-base"
          >
            HOUD <br />
            LAB
          </p>
        </div>
      </div>
    </header>

    <!-- MAIN GRID -->
    <main class="flex-1 grid grid-cols-12 gap-8 p-8 max-h-[calc(100vh-80px)]">
      <!-- LEFT -->
      <div class="col-span-12 lg:col-span-3"></div>

      <!-- CENTER CHAT -->
      <div class="col-span-12 lg:col-span-6">
        <ChatPanel client:load className="h-full" />
      </div>

      <!-- RIGHT -->
      <aside class="col-span-12 lg:col-span-3 flex flex-col gap-6">
        <KageCarousel stories={demo} client:load className="flex-1" />
        <div class="rounded-2xl">
          <TestimonialsCarouselAm
            client:load
            items={testimonials}
            heightClass="max-h-[240px] min-h-[200px]"
            className="rounded-2xl overflow-hidden"
          />
        </div>
      </aside>
    </main>
    <!-- FOOTER -->
    <footer class="h-20 flex items-center justify-center">
      <Footer />
    </footer>
  </body>
</html>
