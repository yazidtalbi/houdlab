---
import "../../styles/global.css"; // ✅ correct path from /pages/projects/
import { projects, ALL_TAGS } from "@/data/projects";
import ProjectCard from "@/components/ProjectCard.astro";
import TestimonialsCarousel from "@/components/TestimonialsCarousel";
import testimonials from "@/data/testimonials";

const title = "Work — Projects";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-neutral-900 antialiased font-display">
    <!-- Simple header (no blur) -->
    <header class="sticky top-0 z-40 bg-white border-b border-neutral-200/60">
      <div
        class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between"
      >
        <a href="/" class="flex items-center gap-2">
          <img src="/hyhy.png" alt="Houd Lab" class="logo-img" />
        </a>
        <nav class="hidden md:flex items-center gap-6 text-[15px] font-medium">
          <a href="/projects" class="text-neutral-900">work</a>
          <a href="/services" class="text-neutral-600 hover:text-neutral-900"
            >services</a
          >
          <a href="/about" class="text-neutral-600 hover:text-neutral-900"
            >about</a
          >
          <a href="/blog" class="text-neutral-600 hover:text-neutral-900"
            >blog</a
          >
          <a href="/lab" class="text-neutral-600 hover:text-neutral-900">lab</a>
          <a
            href="/contact"
            class="ml-2 rounded-full px-3 py-1.5 text-[14px] font-semibold text-indigo-600 border border-indigo-300/50 hover:bg-indigo-50"
          >
            contact us
          </a>
        </nav>
      </div>
    </header>

    <!-- Watermark + heading -->
    <section class="relative">
      <div
        class="pointer-events-none select-none absolute inset-x-0 -top-8 text-[72px] md:text-[120px] lg:text-[160px] font-semibold leading-none text-neutral-100"
      >
        <div class="max-w-7xl mx-auto px-6">work</div>
      </div>

      <div class="max-w-7xl mx-auto px-6 pt-12 md:pt-16">
        <h1
          class="text-[40px] md:text-[64px] lg:text-[84px] font-semibold tracking-[-0.03em] leading-[0.95]"
        >
          we offer the diversity of skills
        </h1>

        <!-- Filter pills -->
        <div class="mt-6 flex flex-wrap gap-2 md:gap-3">
          <button data-filter="all" class="filter-pill is-active">All</button>
          {
            ALL_TAGS.map((tag) => (
              <button data-filter={tag} class="filter-pill">
                {tag}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Projects grid -->
    <section class="contaisner mx-auto px-4 xl:px-10 pt-10 max-w-[1600px]">
      <div
        id="projectsGrid"
        class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-14"
      >
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>

    <!-- Tiny filter script -->
    <script is:inline>
      const pills = Array.from(document.querySelectorAll(".filter-pill"));
      const cards = Array.from(
        document.querySelectorAll("#projectsGrid article")
      );

      function apply(filter) {
        cards.forEach((card) => {
          const tags = (card.getAttribute("data-tags") || "")
            .split(",")
            .map((s) => s.trim());
          const show = filter === "all" || tags.includes(filter);
          card.style.display = show ? "" : "none";
        });
      }
      pills.forEach((btn) => {
        btn.addEventListener("click", () => {
          pills.forEach((p) => p.classList.remove("is-active"));
          btn.classList.add("is-active");
          apply(btn.dataset.filter);
        });
      });
      apply("all");
    </script>

    <!-- Inline tweaks -->
    <style is:inline>
      /* Force small logo regardless of global img rules */
      .logo-img {
        height: 28px;
        width: auto;
        display: block;
      }

      .filter-pill {
        @apply rounded-full border border-neutral-200 px-3 md:px-4 py-1.5 text-[13px] md:text-[14px] font-medium text-neutral-700 hover:bg-neutral-50;
      }
      .filter-pill.is-active {
        @apply bg-neutral-900 text-white border-neutral-900;
      }
    </style>
  </body>
</html>
