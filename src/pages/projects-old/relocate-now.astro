---
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import CaseSummary from "@/components/CaseSummary.astro";

const pageTitle = "RELOCATE NOW";
---

<ProjectLayout
  title={pageTitle}
  parentLabel="PROJECTS"
  parentHref="/projects"
  heroSrc="https://placehold.co/1600x900"
  heroAlt="Woman with hat overlooking cityscape"
>
  <!-- INTRO -->
  <Fragment slot="intro">
    <h1
      class="text-5xl md:text-6xl lg:text-6xl font-semibold leading-[1.15] max-w-3xl"
    >
      Relocate Now — a memorable brand story inspired by home
    </h1>
  </Fragment>

  <!-- SUMMARY (structure fixed, content via props) -->
  <Fragment slot="summary">
    <CaseSummary
      blurb="Fireside is the first membership community for pediatric dentists with access to exclusive resources, expert support, and vendor discounts to grow practice with ease."
      websiteHref="#"
      websiteLabel="visit website"
      services={["Web Design", "Development", "Motion Design"]}
      industries={["Business Consulting and Services", "Pediatric Dentistry"]}
      challenge="Create an engaging and light-feeling design for Fireside’s website, showcasing the product and ensuring ease-of-connection with users."
      whatWeDid={[
        "Created the website’s structure from scratch",
        "Found a positive design direction the team was happy with",
        "Crafted the design to pair with the existing logo and media",
      ]}
    />

    <!-- Optional image after the summary -->
    <div class="w-full overflow-hidden pt-32">
      <img
        src="https://placehold.co/900x600"
        alt="Case study visual"
        class="w-full h-full object-cover rounded-2xl"
      />
    </div>
  </Fragment>

  <!-- DEFAULT SLOT ... keep your other sections -->

  <!-- DEFAULT SLOT -->
  <section class="max-w-3xl pt-16">
    <h2
      class="max-w-xl text-[34px] sm:text-[42px] md:text-[52px] lg:text-4xl leading-[1.08] tracking-[-0.015em] font-semibold"
    >
      All-In-One Solution For Stress-Free Global Moves Where No Detail Is Ever
      Overlooked
    </h2>

    <div
      class="mt-10 md:mt-14 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20"
    >
      <p class="text-[18px] leading-8 font-medium max-w-prose">
        Relocate Now, a spin-off of the Portuguese advisory firm Westonbridge,
        simplifies moving to a new country— from paperwork to housing.
      </p>
      <p class="text-[18px] leading-8 font-medium max-w-prose">
        A multi-disciplinary team handles documents, pet transport, and all the
        small details for a worry-free relocation.
      </p>
    </div>
  </section>

  <section class="relative z-20 bg-white mt-24">
    <div class="w-full h-[480px] md:h-[640px] overflow-hidden">
      <img
        src="https://placehold.co/1600x900"
        alt="Full-bleed visual"
        class="w-full h-full object-cover"
      />
    </div>
  </section>
</ProjectLayout>
