---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LeadChat from "@/components/LeadChat";
---

<BaseLayout title="Lead Chat FAQ">
  <main class="mx-auto max-w-4xl px-4 py-12">
    <div class="mb-6">
      <h1 class="text-3xl font-semibold text-neutral-900">Lead Chat</h1>
      <p class="mt-2 text-sm text-neutral-600">
        Try the FAQ chips for instant answers, even when offline.
      </p>
    </div>
    <LeadChat client:load />
  </main>
</BaseLayout>

