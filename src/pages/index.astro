        <!-- RIGHT -->
        <aside
          class="col-span-12 lg:col-span-3 flex flex-col gap-6 min-h-0 overflow-hidden reveal-up-secondary"
        >
          <KageCarousel stories={demo} client:load className="flex-1 min-h-0" />
          <div class="rounded-2xl">
            <TestimonialsCarouselAm
              client:load
              items={testimonials}
              heightClass="max-h-[240px] min-h-[200px]"
              className="rounded-2xl overflow-hidden"
            />
          </div>
        </aside>
      </main>

      <GlobeBackground client:load />
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-[65%] rotate-5 -z-8"
      >
        <div
          class="absolute inset-0 bg-gradient-to-b from-transparent via-white/100 to-white blur-sm"
        >
