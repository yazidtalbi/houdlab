                mask="url(#revealMask)"></path>
            </svg>
          </div>

          <!-- Wherever your chat message list lives -->
          <div
            data-lenis-prevent
            data-lenis-prevent-wheel
            data-lenis-prevent-touch
            class="h-full overflow-y-auto overscroll-contain touch-pan-y reveal-up"
          >
            <ChatPanel client:load />
          </div>
        </div>

        <!-- 3) Video + description column (3) -->
        <aside
          class="col-span-12 lg:col-span-3 xl:col-span-3 flex flex-col gap-8 z-10 reveal-up-secondary"
        >
          <!-- Description -->

          <!-- Video -->
          <div
            class="order-1 lg:order-2 flex-1 min-h-0 rounded-2xl overflow-hidden bg-neutral-200/50 relative group h-full"
          >
            <VideoPreview
              client:load
              src="https://d3vlq52qrgdnc2.cloudfront.net/UIUX-Showreel-preview-big.mp4"
              className="col-span-12 lg:col-span-8 order-1 lg:order-2 flex-1 min-h-0 h-full rounded-2xl overflow-hidden bg-neutral-200/50 relative group"
            />
          </div>

          <div class="order-3 lg:order-3">
            <TestimonialsCarousel
              client:load
              testimonials={testimonials}
              intervalMs={6000}
              autoplay
            />
          </div>
        </aside>
      </section>
    </main>
    <section class="py-16">
      <div class="mx-auto px-4 text-center max-w-4xl py-6">
        <!-- Divider with text -->
        <div class="flex items-center justify-center mb-12">
          <div class="flex-grow border-t border-gray-300"></div>
          <span class="px-4 text-gray-600 text-sm md:text-base">
            Join the 1000+ companies benefiting from HoudLab’s design expertise
          </span>
          <div class="flex-grow border-t border-gray-300"></div>
        </div>

        <!-- Logos -->
        <div
          class="flex flex-wrap justify-center items-center gap-14 filter grayscale opacity-40 transition"
        >
          <img src="/logos/logo1.svg" alt="Logo 1" class="h-10 md:h-8" />
          <img src="/logos/logo2.svg" alt="Logo 2" class="h-10 md:h-8" />
          <img src="/logos/logo3.svg" alt="Logo 3" class="h-10 md:h-8" />
          <img src="/logos/logo4.svg" alt="Logo 4" class="h-10 md:h-8" />
        </div>
      </div>
    </section>

    <ProcessOverview client:load />
    <!-- (optional) extra sections below -->
    <main class="max-w-4xl mx-auto p-4 md:p-4"></main>
    <!-- Testimonials header -->

    <div class="">
      <section class="flex items-center justify-center gap-6 mb-12 md:mb-16">
        <!-- Left laurel -->

        <img
          src="/king.svg"
          alt=""
          class="w-20 h-20 md:w-26 md:h-26 transform scale-x-[-1]"
        />
        <!-- Center text -->
        <div class="text-center">
          <h2 class="text-2xl md:text-3xl font-semibold mb-2">
            Trusted by Startups<br />& Growing Businesses
          </h2>
          <p class="text-neutral-600">
            We help our clients scale, refine, and succeed
          </p>
        </div>

        <!-- Right laurel (flipped horizontally) -->
        <img src="/king.svg" alt="" class="w-20 h-20 md:w-26 md:h-26" />
      </section>
      <TestimonialsMarquee client:load />
    </div>

    <!-- Footer Navigation -->
    <Footer />
  </body>
  <!-- Put this near the end of index.astro (before </body>) -->
  <script type="module">
    const btns = document.querySelectorAll("[data-scroll-to-chat]");
    const chatSection = document.getElementById("chat");
    const chatInput = document.getElementById("chat-input");

    function focusInputAfterScroll() {
      // Give the browser a tick to finish smooth scroll & layout
      setTimeout(() => {
        chatInput?.focus({ preventScroll: true });
      }, 450);
    }

    btns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        // If it's an anchor with #chat, default smooth behavior will run thanks to CSS.
        // We only ensure focus after.
        if (chatSection) {
          focusInputAfterScroll();
        }
      });
    });

    // Also handle direct #chat visits / hash changes
    if (location.hash === "#chat-section") focusInputAfterScroll();
    window.addEventListener("hashchange", () => {
      if (location.hash === "#chat-section") focusInputAfterScroll();
    });
  </script>

  <script type="module">
    const btn = document.querySelector("[data-scroll-to-chat]");
    const chatSection = document.getElementById("chat-section");
    const chatInput = document.getElementById("chat-input");

    btn?.addEventListener("click", () => {
      if (!chatSection) return;

      // Smooth scroll
      chatSection.scrollIntoView({ behavior: "smooth", block: "center" });

      // Focus input after scroll
      setTimeout(() => {
        chatInput?.focus({ preventScroll: true });
      }, 500); // adjust timing if needed
    });
  </script>

  <script type="module">
    import Lenis from "@studio-freight/lenis";

    // Init with autoRaf
    const lenis = new Lenis({
      autoRaf: true,
      duration: 1.1, // smooth speed
      easing: (t) => 1 - Math.pow(1 - t, 2), // quad ease-out
      smoothWheel: true,
      smoothTouch: false, // set true if you want on touch
    });

    // Optional: listen to scroll events
    lenis.on("scroll", (e) => {
      // console.log(e)
    });
  </script>

  <script type="module">
    // Grab elements
    const trigger = document.getElementById("floating-chat-trigger");
    const chatSection = document.getElementById("chat-section");
    const getChatInput = () => document.getElementById("chat-input");

    // How tall is your fixed header? (logo row). Adjust as needed.
    const HEADER_OFFSET = 96; // px

    // Visibility check: is the chat section within the viewport area?
    function chatIsVisible() {
      if (!chatSection) return false;
      const r = chatSection.getBoundingClientRect();
      // Visible if any part is between header bottom and viewport bottom
      const topVisible = r.top < window.innerHeight;
      const bottomVisible = r.bottom > HEADER_OFFSET;
      return topVisible && bottomVisible;
    }

    function showTrigger() {
      if (!trigger) return;
      trigger.classList.remove("opacity-0", "pointer-events-none");
    }
    function hideTrigger() {
      if (!trigger) return;
      trigger.classList.add("opacity-0", "pointer-events-none");
    }

    // Update on scroll/resize
    function update() {
      if (!trigger || !chatSection) return;
      chatIsVisible() ? hideTrigger() : showTrigger();
    }

    // Click → smooth scroll via Lenis if available, else native
    function scrollToChat() {
      const input = getChatInput();
      const lenis = window.__lenis || window.lenis;

      if (lenis && typeof lenis.scrollTo === "function") {
        // Scroll all the way to the top of the page
        lenis.scrollTo(0, { duration: 1.0 });
        // Focus after scroll animation ends
        setTimeout(() => input?.focus({ preventScroll: true }), 850);
      } else {
        // Fallback: native smooth scroll
        window.scrollTo({ top: 0, behavior: "smooth" });
        setTimeout(() => input?.focus({ preventScroll: true }), 600);
      }
    }

    trigger?.addEventListener("click", (e) => {
      e.preventDefault();
      scrollToChat();
    });

    // ——— Hook into Lenis if your SmoothScroll exposes it on window ———
    // If your SmoothScroll component sets: window.__lenis = lenis
    // then this will work. Otherwise, we also attach a rAF loop fallback.
    function attachLenis() {
      const ln = window.__lenis || window.lenis;
      if (ln && typeof ln.on === "function") {
        ln.on("scroll", update);
        update(); // initial
        return true;
      }
      return false;
    }

    // Try to attach to Lenis now; if not yet available, poll a few times.
    if (!attachLenis()) {
      let tries = 0;
      const t = setInterval(() => {
        if (attachLenis() || ++tries > 20) {
          clearInterval(t);
          // rAF fallback so it still works even if we never got a Lenis ref
          if (tries > 20) {
            const loop = () => {
              update();
              requestAnimationFrame(loop);
            };
            loop();
          }
        }
      }, 100);
    }

    window.addEventListener("resize", update);
  </script>
</html>
