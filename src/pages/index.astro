---

<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <BaseLayout
    title="Design & Development Partner for Founders"
    class="font-display lg:h-dvh lg:overflow-hidden"
  >
    <body class="flex flex-col min-h-screen mx-auto">
      <!-- lg:h-dvh lg:overflow-hidden -->
      <header class="fixed top-9 left-0 w-full z-50">
        <div class="flex items-center gap-6 pl-8 pr-8" role="banner">
          <!-- Logo link -->
          <a
            href="/"
            aria-label="Houd Lab"
            class="flex items-center gap-3 group"
          >
            <img
              src="/hyhy.png"
              alt="Houd Lab Logo"
              class="h-12 w-auto transition-transform duration-300 group-hover:scale-105"
            />
          </a>

          <!-- Divider + text -->
          <div class="pl-2 -ml-1 pb-1">
            <p
              class="text-neutral-800 font-display font-semibold text-xl leading-tight md:leading-snug"
            >
              Houd Lab
            </p>
          </div>
        </div>
      </header>

      <!-- MAIN GRID -->
      <main
        class="flex-1 grid grid-cols-12 gap-8 p-8 pb-2 pt-8 lg:h-[calc(100dvh-5rem)] lg:overflow-hidden min-h-0"
      >
        <!-- LEFT -->
        <div class="col-span-12 lg:col-span-3">
          <!-- plain link -->
          <!-- Plain link -->

          <!-- Or inside React -->
          <!-- <div class="container pt-32">
            <a href="/work#allied" class="btn">View Allied</a>

            <a href="/work#zemium" class="btn">View zes</a>
          </div> -->
        </div>

        <!-- CENTER CHAT -->
        <div
          class="col-span-12 lg:col-span-6 min-h-0 flex flex-col overflow-visible reveal-up"
        >
          <!-- <ShowcaseDialog client:load title="زيــميوم — Case Study">
          <ProjectShowcase
            titleAr="زيــميوم"
            subtitle="We partnered with Things founder to design the branding for his next venture."
            rows={rows}
          />
        </ShowcaseDialog> -->

