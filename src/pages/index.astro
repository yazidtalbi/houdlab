                d="M182.03,114.57c0,2.23-1.45,5.77-4.35,10.62-4.46,7.47-8.97,13.13-13.54,16.97-4.57,3.85-10.98,7.39-19.23,10.62-9.36,3.68-21.4,6.74-36.12,9.2-13.93,2.34-26.22,3.51-36.87,3.51-22.29,0-34.95-3.96-37.96-11.87-.89-2.34-1.34-6.19-1.34-11.54,0-3.18,.53-7.47,1.59-12.88,1.34-6.69,2.84-10.03,4.51-10.03,1.11,0,1.67,.5,1.67,1.5,0,.72-.14,1.78-.42,3.18-.22,1.39-.33,2.45-.33,3.18,0,11.98,11.54,17.97,34.61,17.97,24.97,0,47.29-2.56,66.97-7.69,16.94-4.35,28.17-10.2,33.69-17.56l5.43-7.19c1.11,.78,1.67,1.45,1.67,2.01Zm-61.53,70.73c0,1.95-4.9,6.35-14.71,13.21-3.29-3.79-5.38-6.13-6.27-7.02-3.34-3.4-5.74-5.1-7.19-5.1v-1.09l15.22-14.46c8.64,6.07,12.96,10.9,12.96,14.46ZM237.08,32.22c-.73,9.87-1.48,24.91-2.26,45.15-.28,27.14-4.6,47.57-12.96,61.28-5.8,9.47-14.43,14.21-25.92,14.21-2.68,0-5.69-.61-9.03-1.84-3.29-1.23-4.93-2.31-4.93-3.26,0-.61,1.06-1.23,3.18-1.84,1.67-.39,3.35-.81,5.02-1.25,3.29-12.32,4.93-23.77,4.93-34.36,0-1.28-.06-3.23-.17-5.85-.06-2.68-.08-4.65-.08-5.94,0-16.61,3.93-32.33,11.79-47.15,.73,0,1.39,.5,2.01,1.5-2.23,9.14-3.34,24.24-3.34,45.31,0,9.14-1,17.67-3.01,25.58-1.84,6.3-3.68,12.62-5.52,18.98,4.29-1.45,7.25-2.62,8.86-3.51,3.07-1.67,5.96-4.12,8.69-7.36,4.51-5.41,7.44-13.85,8.78-25.33,.61-5.74,.92-16.27,.92-31.6,0-6.8,1.09-14.44,3.26-22.91,2.28-9.08,5.16-16.16,8.61-21.24l1.17,1.42Zm40.43,80.51c0,1.28-1,4.71-3.01,10.28-5.24,14.55-10.56,24.08-15.97,28.59-1.56,1.28-6.58,3.18-15.05,5.68-8.69,2.56-13.68,3.85-14.96,3.85-2.17,0-3.51-.72-4.01-2.17,7.86-4.18,15.69-8.36,23.49-12.54,10.31-6.52,15.47-12.71,15.47-18.56,0-3.68-1.37-7.69-4.1-12.04-.17-.33-2.73-3.85-7.69-10.53,7.13-13.93,11.45-20.9,12.96-20.9,.56,0,1.92,1.39,4.1,4.18,5.85,7.41,8.78,15.47,8.78,24.16Zm41.51,33.53h-2.17c-2.51,0-4.54,2.29-6.1,6.86-4.18,12.26-9.03,20.79-14.55,25.58-3.34,2.9-9.03,5.96-17.06,9.2-7.19,2.84-11.87,4.26-14.04,4.26-.84,0-1.45-.31-1.84-.92,.28-.56,3.23-2.87,8.86-6.94,7.25-5.24,12.82-9.5,16.72-12.79,11.15-9.36,16.72-16.5,16.72-21.4,0-.95-.59-1.42-1.76-1.42-3.68,0-7.72-.89-12.12-2.68-4.57