---
import "../styles/global.css";
import "lenis/dist/lenis.css";
import VideoReel from "../components/VideoReel";
import TestimonialsMarquee from "../components/TestimonialsMarquee";
import ChatPanel from "../components/ChatPanel";
import GlobeBackground from "../components/GlobeBackground";
import SmoothScroll from "../components/SmoothScroll";
import VideoPreview from "@/components/VideoPreview";

import ProcessOverview from "@/components/ProcessOverview";

import TestimonialsCarousel from "../components/TestimonialsCarousel";
import testimonials from "@/data/testimonials"; // [{ quote, name, role, company, avatar }, ...]

import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Houd Lab — Establishing Brands & Products</title>
    <meta
      name="description"
      content="Chat with a design expert and get your project scope in minutes."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- OG / Twitter -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Houd Lab — Establishing Brands & Products"
    />
    <meta
      property="og:description"
      content="Chat with a design expert and get your project scope in minutes."
    />
    <meta property="og:image" content="/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      .globe-wrapper {
        opacity: 0;
        transform: translateX(80px); /* start off to the right */
        animation: slideIn 1.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        animation-duration: 7s;
      }

      @keyframes slideIn {
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }
    </style></head
  >

  <body class="bg-[#FFFFFF] text-neutral-900 font-display">
    <SmoothScroll client:load />

    <!-- Put this right after <body> -->

    <!-- Navbar -->
    <!-- Navbar -->
    <header class="fixed top-12 left-0 w-full z-50">
      <div class="flex items-center gap-6 pl-10">
        <!-- Logo -->
        <a href="/" aria-label="Houd Lab">
          <img src="/hyhy.png" alt="Houd Lab Logo" class="h-12 w-auto" />
        </a>

        <!-- Location -->
        <div class="border-l border-gray-200 pl-6">
          <p
            class="text-neutral-800 font-display font-semibold lg:text-base text-xl leading-tight md:leading-snug"
          >
            HOUD LAB
          </p>
          <p class="text-gray-400 text-sm">Working globally</p>
        </div>
      </div>

      <!-- Floating mini input (centered) -->
      <div
        id="floating-chat-trigger"
        class="fixed top-12 left-1/2 -translate-x-1/2 hidden lg:flex items-center gap-2 rounded-full border border-neutral-300 bg-white pl-4 pr-12 py-2 text-sm text-neutral-700 shadow-md transition-all duration-300 opacity-0 pointer-events-none cursor-text w-lg"
        role="button"
        tabindex="0"
        aria-label="Start your project"
      >
        <span aria-hidden="true" class="text-gray-900 text-lg">💬</span>
        <span class="text-gray-900/40 text-[15px] truncate"
          >Start your project…</span
        >

        <!-- Send button -->
        <button
          type="button"
          class="absolute right-1 top-1 bottom-1 my-auto grid h-9 w-9 place-items-center rounded-full bg-neutral-300 text-white hover:bg-neutral-800 transition"
          aria-label="Send message"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="h-5 w-5"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M20.33 3.67c-.19-.19-.43-.32-.69-.38-.26-.06-.53-.05-.78.07L4.23 8.2c-.27.09-.51.27-.67.5-.16.22-.26.49-.28.77-.02.28.04.55.17.8.13.25.33.46.55.58l6.07 3 3 6.09c.12.25.31.46.55.6.24.14.52.22.8.22h.1c.29-.02.57-.13.8-.31.23-.18.39-.43.47-.71l4.95-14.6c.09-.26.09-.54.01-.8-.08-.26-.24-.49-.45-.67ZM4.85 9.58l12.77-4.26-7.09 7.09-5.68-2.83Zm9.58 9.57-2.84-5.68 7.09-7.09-4.25 12.77Z"
            ></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- soft page bg -->
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(1200px_600px_at_10%_-10%,rgba(255,224,130,0.06),transparent_60%)]"
    >
    </div>

    <main class="contaisner mx-auto px-4 xl:px-10 pt-10 max-w-[1600px]">
      <!-- Make the section relative so the globe can be absolutely positioned inside it -->
      <section class="relative grid grid-cols-12 gap-4 lg:gap-8 items-stretch">
        <!-- Soft radial fade + optional blue highlight arc over the globe -->
        <div
          class="pointer-events-none absolute -z-5 left-[2vw] top-[35vh] w-[95vmin] h-[95vmin]"
        >
          <!-- 1) Soft white radial fade (makes the globe blend into the background) -->
          <div
            class="absolute inset-0 rounded-full opacity-70 blur-2xl
			 bg-[#FFFFFF]"
          >
          </div>

          <!-- 2) Optional colored arc (subtle blue sweep) -->
          <div
            class="absolute inset-0 rounded-full blur-xl opacity-50
			 bg-[#FFFFFF]"
          >
          </div>
        </div>
        <GlobeBackground client:load />

        <!-- 1) Empty column (2) — shows background -->
        <div class="col-span-3 hidden xl:block xl:col-span-3 lg:col-span-2">
        </div>

        <!-- 2) Chat column (7) -->
        <div
          class="col-span-12 lg:col-span-6 xl:col-span-6 z-10"
          id="chat-section"
        >
          <!-- Arabic SVG anchored behind the chat panel -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -z-10 left-[-20px] top-[650px] -translate-y-1/2 w-[512px] h-[512px] -rotate-5 opacity-75"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              id="vmn"
              data-name="vmn"
              viewBox="0 0 390.31 218.68"
            >
              <defs>
                <style>
                  .mask-stroke {
                    stroke-dasharray: 2000;
                    stroke-dashoffset: 2000;
                    animation: reveal 5s ease;
                    animation-fill-mode: forwards;
                  }

                  @keyframes reveal {
                    to {
                      stroke-dashoffset: 0;
                    }
                  }

                  .cls-1 {
                    fill: #fabc4b;
                  }
                </style>

                <mask id="revealMask">
                  <path
                    class="mask-stroke"
                    d="M347.85,71.27s1.98,16.47,13.27,21.74,13.36,9.6,14.49,14.49,4.52,10.54-3.39,15.06-13.18,5.27-21.46,3.01-18.82-3.39-20.71-8.28,3.39-20.33,9.79-25.98c8.49-7.49,15.81,3.01,15.81,7.15s-5.27,35.76-39.53,41.41-28.99-6.02-21.46-15.81,9.41-21.08,12.42-12.42,6.02,42.16-3.39,52.33-20.71,18.82-28.61,22.21-22.14,.79-14.68,4.52c12.8,6.4,62.12-125.74,62.12-125.74l-55.72,25.98s-6.02,11.29-.75,23.72,1.88,23.72-10.54,32-18.07,11.67-20.33,11.67,34.26-46.31,39.53-95.62-31.25-49.69-31.25-49.69l-6.4,1.51s-6.4,56.85-9.41,79.44-6.56,50.6-28.61,53.46c-5.08,.66,34.26-111.81,34.26-111.81l-24.66,7.44s1.88,112.75-21.46,125.93c-23.34,13.18-8.85-21.55-8.85-21.55,0,0,27.52-21.88,16.61-42.96s-21.59,3.53-21.59,3.53c0,0-5.93,10.73-13.14,19.11-7.8,9.07-20.4,21.65-51.15,25.98-58.9,8.29-79.81,8.66-70.02-38.4s-25.98,11.67-25.98,11.67l1.51,76.42,133.65-27.86"
