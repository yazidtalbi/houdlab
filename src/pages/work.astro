---
import SmoothScroll from "@/components/SmoothScroll";
import ResizableChatPanel from "@/components/ResizableChatPanel.tsx";
import BaseLayout from "@/layouts/BaseLayout.astro";
import KageModal from "@/components/KageModal";
import WorkContent from "@/components/WorkContent.astro";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      /* Progressive "zoom" scaling for ultra-wide screens */

      @media (min-width: 1600px) {
        .test {
          font-size: px !important;
        }
      }
    </style></head
  >

  <BaseLayout
    title="Works"
    description="Design partner for founders. We build brands, web designs, dashboards, and web apps that blend clarity with craft."
    ><body class="min-h-screen">
      <SmoothScroll client:load />
      <!-- Desktop logo column (left of chat) -->
      <aside class="hidden lg:block fixed left-0 top-12 w-20 z-40">
        <div class="flex justify-center px-2">
          <a href="/" aria-label="Houd Lab" class="group">
            <img
              src="/hyhy.png"
              alt="Houd Lab Logo"
              class="h-12 w-auto transition-transform duration-300 group-hover:scale-105"
            />
          </a>
        </div>
      </aside>
      <aside class="hidden lg:block fixed left-0 bottom-10 w-20 z-40">
        <div class="flex justify-center px-2">
          <KageModal
            client:load
            triggerVariant="ghost"
            triggerSize="sm"
            triggerClassName="h-auto px-0 py-0 !text-[13px] font-medium text-black hover:text-neutral-900 bg-transparent hover:bg-transparent border-0"
            triggerLabel="About"
          />
        </div>
      </aside>

      <!-- Desktop chat panel - hidden on mobile -->
      <ResizableChatPanel client:load leftOffset={64} />
      <div class="flex min-h-screen">
        <!-- RIGHT: Main Content -->
        <main class="flex-1 pb-10" id="work-main-content">
          <WorkContent />
        </main>
      </div>

      <script is:inline>
        // Find nearest scrollable ancestor
        function getScrollContainer(el) {
          let p = el?.parentElement;
          while (p && p !== document.body) {
            const cs = getComputedStyle(p);
            if (
              (cs.overflowY === "auto" || cs.overflowY === "scroll") &&
              p.scrollHeight > p.clientHeight
            )
              return p;
            p = p.parentElement;
          }
          return document.scrollingElement || document.documentElement; // window
        }

        function headerOffsetPx() {
          const hdr =
            document.querySelector("[data-sticky-header]") ||
            document.querySelector("header.sticky, header.fixed");
          return hdr ? hdr.getBoundingClientRect().height : 0;
        }

        function jumpToHash() {
          const id = location.hash.slice(1);
          if (!id) return;
          const el = document.getElementById(id);
          if (!el) return;

          const container = getScrollContainer(el);
          const off = headerOffsetPx();

          // Compute top of el within container
          let y = 0,
            n = el;
          while (n && n !== container) {
            y += n.offsetTop || 0;
            n = n.offsetParent;
          }
          y = Math.max(0, y - off - 280);

          if (container === document.documentElement) {
            // Classic page scroll
            window.scrollTo({ top: y, behavior: "auto" });
          } else {
            // Inner scrollable wrapper
            container.scrollTop = y;
          }
        }

        // Handle initial load + future hash changes + late content
        function kick(tries = 40) {
          const id = location.hash.slice(1);
          if (!id) return;
          const el = document.getElementById(id);
          if (el) {
            jumpToHash();
            // Correct after layout shifts
            setTimeout(jumpToHash, 120);
            setTimeout(jumpToHash, 400);
          } else if (tries > 0) {
            requestAnimationFrame(() => kick(tries - 1));
          }
        }

        // One source of truth: our handler. Disable native smooth to avoid double-jumps.
        try {
          document.documentElement.style.scrollBehavior = "auto";
        } catch {}

        window.addEventListener("hashchange", () => setTimeout(jumpToHash, 0));
        document.addEventListener("DOMContentLoaded", () => kick());
        document.addEventListener("astro:page-load", () => kick());
        document.addEventListener("astro:after-swap", () => kick());
      </script>

      <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
          const sections = document.querySelectorAll("section[id]");
          const options = {
            root: null,
            rootMargin: "0px 0px -60% 0px", // triggers when 40% of section visible
            threshold: 0,
          };

          let current = "";

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute("id");
                if (id && current !== id) {
                  history.replaceState(null, "", `#${id}`);
                  current = id;
                }
              }
            });
          }, options);

          sections.forEach((section) => observer.observe(section));
        });
      </script>

    </body>
  </BaseLayout>
</html>
