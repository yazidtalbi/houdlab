---
import SmoothScroll from "@/components/SmoothScroll";
import "../styles/global.css";
import { ChevronRight } from "@lucide/astro";
import ChatPanel from "@/components/ChatPanel";
import ChatSheet from "@/components/ChatSheet";
import Footer from "@/components/Footer.astro";

interface Props {
  title: string;
  parentLabel?: string;
  parentHref?: string;
  heroSrc?: string;
  heroAlt?: string;
  showHero?: boolean;
  showHeader?: boolean;
  showGoldBanner?: boolean;
  showFooter?: boolean;
}

const {
  title,
  parentLabel = "PROJECTS",
  parentHref = "/",
  heroSrc,
  heroAlt = "",
  showHero = true,
  showHeader = true,
  showGoldBanner = true,
  showFooter = true,
} = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body
    class="bg-[#FFFFFF] text-neutral-900 antialiased font-display"
    id="page-root"
  >
    <!-- Smooth scrolling -->
    <SmoothScroll client:load />

    <!-- Chat (React island) -->
    <ChatSheet client:load title="Chat with Yazid">
      <ChatPanel client:load />
    </ChatSheet>

    <!-- Brand logo -->
    <a href="/" class="fixed top-14 left-12 z-50 block">
      <img src="/hyhy.png" alt="Houd Lab" class="h-12 w-auto" />
    </a>

    <!-- Gold banner -->
    {
      showGoldBanner && (
        <img
          src="/houdbanner.svg"
          alt=""
          class="fixed top-0 right-40 h-[360px] w-auto object-contain pointer-events-none select-none z-10"
        />
      )
    }

    <!-- Breadcrumb header -->
    {
      showHeader && (
        <header class="fixed top-0 left-0 right-0 z-40 py-8">
          <nav class="max-w-7xl mx-auto px-3 py-6 flex items-center justify-between">
            <div class="flex items-center gap-2 bg-white/70 rounded-full px-4 py-2 backdrop-blur-md">
              <a
                href={parentHref}
                class="text-sm font-medium text-gray-400 cursor-pointer"
              >
                {parentLabel}
              </a>
              <span class="text-sm font-semibold text-gray-400">
                <img
                  src="/chevron-right.svg"
                  alt=""
                  class="inline-block h-5 w-5"
                  loading="lazy"
                  decoding="async"
                />
              </span>

              <span class="text-sm font-semibold hover:text-gray-600 transition-colors">
                {title}
              </span>
            </div>
          </nav>
        </header>
      )
    }

    <!-- Intro slot (above hero) -->
    <section class="pt-32">
      <div class="max-w-7xl mx-auto px-6">
        <div class="pt-48">
          <slot name="intro" />
        </div>
      </div>
    </section>

    <!-- Hero image -->
    {
      showHero && heroSrc && (
        <section class="relative z-20 bg-white mt-24">
          <div class="w-full h-[400px] md:h-[500px] lg:h-[800px] overflow-hidden">
            <img
              src={heroSrc}
              alt={heroAlt}
              class="w-full h-full object-cover"
            />
          </div>
        </section>
      )
    }

    <!-- Summary slot -->
    <section class="relative z-20 bg-white">
      <div
        class="mx-auto w-full max-w-8xl px-5 md:px-8 lg:px-14 md:py-24 pt-24"
      >
        <slot name="summary" />
      </div>
    </section>

    <!-- Default slot (main content) -->
    <main>
      <section class="relative z-20 bg-white">
        <div class="mx-auto w-full max-w-8xl px-5 md:px-8 lg:px-14">
          <slot />
        </div>
      </section>
    </main>

    <!-- Footer -->
    {
      showFooter && (
        <section class="relative z-20 bg-white">
          <Footer />
        </section>
      )
    }

    <!-- Optional after-slot -->
    <slot name="after" />
  </body>
</html>
